{
  "name": "openai-codex",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "workspaceMount": "source=openai-codex-src,target=/workspaces/codex,type=volume",
  "workspaceFolder": "/workspaces/codex",
  "features": {
    "ghcr.io/zkaiwen5810/features/ai-coding-cli:0.2.7": {
      "nodeMajor": "22",
      "installZsh": true,
      "installZshrc": true
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer,target=/opt/devcontainer-config,type=bind,readonly",
    "source=cargo-registry,target=/home/node/.cargo/registry,type=volume",
    "source=cargo-git,target=/home/node/.cargo/git,type=volume",
    "source=pnpm-store,target=/home/node/.pnpm-store,type=volume",
    "source=uv-cache,target=/home/node/.cache/uv,type=volume",
    "source=dotslash-cache,target=/home/node/.cache/dotslash,type=volume",
    "source=codex-home,target=/home/node/.codex,type=volume",
    "source=claude-home,target=/home/node/.claude,type=volume",
    "source=claude-config,target=/home/node/.config/claude,type=volume",
    "source=claude-cache,target=/home/node/.cache/claude,type=volume",
    "source=opencode-config,target=/home/node/.config/opencode,type=volume",
    "source=opencode-share,target=/home/node/.local/share/opencode,type=volume",
    "source=claude-code-persist,target=/home/node/.persist,type=volume"
  ],
  "containerEnv": {
    "npm_config_store_dir": "/home/node/.pnpm-store",
    "UV_CACHE_DIR": "/home/node/.cache/uv",
    "CARGO_BUILD_JOBS": "2",
    "SHELL": "/usr/bin/zsh"
  },
  "postCreateCommand": "bash /opt/devcontainer-config/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "tamasfe.even-better-toml"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "rust-analyzer.linkedProjects": ["codex-rs/Cargo.toml"],
        "rust-analyzer.numThreads": 2,
        "rust-analyzer.cachePriming.enable": false,
        "rust-analyzer.lru.capacity": 64,
        "rust-analyzer.checkOnSave": false,
        "rust-analyzer.cargo.buildScripts.enable": false,
        "rust-analyzer.procMacro.enable": false,
        "rust-analyzer.cargo.extraEnv": {
          "CARGO_BUILD_JOBS": "2"
        },
        "files.watcherExclude": {
          "**/target/**": true,
          "**/node_modules/**": true,
          "**/.venv/**": true,
          "**/bazel-*/**": true
        },
        "search.exclude": {
          "**/target/**": true,
          "**/node_modules/**": true,
          "**/.venv/**": true,
          "**/bazel-*/**": true
        }
      }
    }
  }
}
